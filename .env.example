PORT=5000
NODE_ENV=production
BASE_URL=https://yourdomain.com
JWT_SECRET=generate_a_very_secure_random_string_here
ADMIN_EMAIL=admin@yourdomain.com
# Use bcrypt to hash your desired password, or leave empty if the system has an initial setup script.
# Actually, the platform uses an in-memory DB that comes pre-seeded, so set this to the bcrypt hash of your desired password.
# Example Hash for 'pilot': $2b$10$Ep9vJ0l4mDth4WlO6XFp.e0eMInpE3e0b0n0GvP0R8H.yV.W5d2G6
ADMIN_PASSWORD_HASH=
